# Oh My Zsh already provides ..., 1-9, _ (sudo), l/la/ll/lsa and the git plugin aliases

# Navigation
alias ~='cd ~'

# Docker
alias dcd='docker compose down'
alias dcu='docker compose up'
alias dcub='docker compose up --build'
alias dcud='docker compose up -d'
alias dps='docker ps'

# Git
alias gc='git commit'
alias gpl='git pull'

# List
alias ls='ls -G'

# Misc
alias c='gh copilot'
alias n='nvim'

# Work
alias gert='cd ~/Documents/01-Work/Equinor/ert'
alias xpoly='uv run just poly'
alias rdypr='git rebase main -i --exec "uv run just rapid-tests"'

